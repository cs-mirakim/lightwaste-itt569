# ==============================================================================
# LightWaste IoT - Environment Variables Template (.env.example)
# ==============================================================================
# Sila salin fail ini kepada .env.local dan masukkan kelayakan Firebase sebenar.
# DO NOT commit .env.local containing real production secrets into GitHub!
# ==============================================================================

# --- Firebase Realtime Database & Client SDK ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKey1234567890
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lightwaste-iot.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://lightwaste-iot-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lightwaste-iot
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lightwaste-iot.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- App Settings ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_GATEWAY_ID=esp8266-gateway-01
