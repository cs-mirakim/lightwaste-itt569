# ==============================================================================
# LightWaste IoT - Git Ignore Rules (.gitignore)
# ==============================================================================

# Dependencies
/node_modules
/.pnpm-store

# Next.js Build & Static Outputs
/.next/
/out/
/build

# Environment & Secret Files (Rigorous security: prevent token/credential leak)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Keep template env files tracked for team collaboration
!.env.example
!.env.local.example

# Debug and Package Manager Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Vercel & Cloudflare Pages Tooling
.vercel
.wrangler

# Turbo & Build Caches
.turbo

# TypeScript Declaration & Cache
*.tsbuildinfo
next-env.d.ts

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editor Temporary Files
.idea/
*.swp
*.swo
*.swn
